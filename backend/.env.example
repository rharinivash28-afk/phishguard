# Copy to backend/.env for local dev. On Render, set these in the dashboard.
# Everything here is OPTIONAL for local dev — with none of it set the app uses a
# local SQLite file and a dev encryption key.

# External Postgres for per-user workspaces (Neon / Supabase free tier).
# Accepts postgres://, postgresql://, or postgresql+psycopg:// URLs.
# Unset -> sqlite:///backend/phishguard.db
DATABASE_URL=

# Key used to encrypt stored Gmail app passwords. Any long random string.
# Unset -> a well-known dev fallback (fine locally, NOT for production).
APP_SECRET_KEY=

# Idle days before an inactive workspace (and its data) is swept. Default 14.
SESSION_TTL_DAYS=

# Background Gmail poll cadence in seconds. Default 60.
POLL_INTERVAL_SECONDS=

# Extra browser origins allowed to call the API (comma-separated). Only needed
# if you serve the frontend from a different host than the backend.
CORS_ALLOW_ORIGINS=
