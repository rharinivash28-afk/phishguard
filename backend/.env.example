# Copy to backend/.env for local dev. On Render, set these in the dashboard.
# Everything here is OPTIONAL for local dev — with none of it set the app uses a
# local SQLite file, a dev encryption key, and all integrations off.

# External Postgres for per-user workspaces (Neon / Supabase free tier).
# Accepts postgres://, postgresql://, or postgresql+psycopg:// URLs.
# Unset -> sqlite:///backend/phishguard.db
DATABASE_URL=

# Key used to encrypt stored Gmail app passwords. Any long random string.
# Unset -> a well-known dev fallback (fine locally, NOT for production).
APP_SECRET_KEY=

# Shared secret for POST /api/cron/poll-tick (the external cron that keeps
# background polling alive on a sleeping free dyno). Unset -> endpoint 403s.
CRON_SECRET=

# --- optional threat-intel integrations ---------------------------------
# Google Safe Browsing v4 API key. Unset -> URL reputation check skipped.
GOOGLE_SAFE_BROWSING_KEY=
# NVIDIA build.nvidia.com key (nvapi-...). Unset -> LLM second opinion off.
NVIDIA_API_KEY=
NVIDIA_MODEL=

# --- optional tuning ---------------------------------------------------
SESSION_TTL_DAYS=          # idle days before a workspace is swept (default 30)
POLL_INTERVAL_SECONDS=     # in-process poll cadence (default 60)
INBOX_RETENTION_DAYS=      # inbox history pruning window (default 30)
MAX_SESSIONS=              # new-workspace flood cap (default 5000)
RATE_LIMIT_ENABLED=        # set to 0 to disable API rate limiting locally

# Extra browser origins allowed to call the API (comma-separated). Only needed
# if you serve the frontend from a different host than the backend.
CORS_ALLOW_ORIGINS=
