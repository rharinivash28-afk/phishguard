# Copy to backend/.env for local dev. On Render, set these in the dashboard instead.
# All are optional — the app runs without them and you can add the Google client
# from inside the UI (Connect Gmail -> Google sign-in -> One-time setup).

# Google OAuth client (APIs & Services -> Credentials -> OAuth client ID -> Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed if the auto-derived value is wrong (custom domain, proxy, etc.)
# Local dev default:  http://localhost:5173/api/auth/google/callback
# Render default:     https://<your-service>.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Public base URL of the deployed app (used to build the redirect URI when
# GOOGLE_REDIRECT_URI is unset). Render provides RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=

# Filled in automatically after a successful Google sign-in — do not set by hand.
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER_EMAIL=
